
<%- include("partials/header",{title:"Edit Dish"}) %>

<div class="container mt-4 col-lg-8">

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h4 class="mb-0">
                ✏️ Edit Dish
            </h4>

            <button
                form="dishForm"
                type="submit"
                class="btn btn-success">

                💾 Save

            </button>

        </div>

        <div class="card-body">

            <form
                id="dishForm"
                method="POST"
                action="/dishes/<%= dish.DishID %>/editDish">

                <div class="mb-3">

                    <label class="form-label">

                        Dish Name

                    </label>

                    <input
                        type="text"
                        name="dishName"
                        class="form-control"
                        value="<%= dish.DishName %>"
                        required>

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Recipe Link

                    </label>

                    <input
                        type="text"
                        name="recipe"
                        class="form-control"
                        value="<%= dish.recipe %>">

                </div>

            </form>

            <hr>

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">

                    🥕 Ingredients

                </h5>

                <span class="badge bg-secondary">

                    <%= dishIngredients.length %>

                </span>

            </div>

            <% if(dishIngredients.length === 0){ %>

                <div class="text-center text-muted py-4">

                    No ingredients added yet.

                </div>

            <% } else { %>

                <table class="table align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Ingredient</th>

                            <th width="180">Quantity</th>

                            <th width="70"></th>

                        </tr>

                    </thead>

                    <tbody>

                        <% dishIngredients.forEach(item=>{ %>

                            <tr>

                                <td>

                                    <%= item.IngredientName %>

                                </td>

                                <td>

                                    <%= item.Quantity %>

                                </td>

                                <td class="text-end">

                                    <a

                                        href="/dishes/<%= dish.DishID %>/ingredients/<%= item.IngredientID %>/delete"

                                        class="btn btn-outline-danger btn-sm"

                                        onclick="return confirm('Remove this ingredient?')">

                                        🗑

                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            <% } %>

            <form
                method="POST"
                action="/dishes/<%= dish.DishID %>/ingredients"
                class="border-top pt-3 mt-3">

                <div class="row g-2 align-items-end">

                    <div class="col-md-5">

                        <label class="form-label small text-muted">

                            Add Ingredient

                        </label>

                        <select
                            name="ingredientId"
                            class="form-select form-select-sm"
                            required>

                            <option value="">

                                Select

                            </option>

                            <% ingredients.forEach(ingredient=>{ %>

                                <option value="<%= ingredient.IngredientID %>">

                                    <%= ingredient.IngredientName %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="col-md-5">

                        <label class="form-label small text-muted">

                            Quantity

                        </label>

                        <input
                            type="text"
                            name="quantity"
                            class="form-control form-control-sm"
                            placeholder="e.g. 500 g"
                            required>

                    </div>

                    <div class="col-md-2">

                        <button
                            class="btn btn-outline-success btn-sm w-100">

                            Add

                        </button>

                    </div>

                </div>

            </form>

        </div>

        <div class="card-footer text-start">

            <a
                href="/dishes"
                class="btn btn-outline-secondary">

                ← Back to Dishes

            </a>

        </div>

    </div>

</div>

<%- include("partials/footer") %>

