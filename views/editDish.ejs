<%- include("partials/header",{title:"Edit Dish"}) %>
<h1>Edit Dish</h1>

<form action="/dishes/<%= dish.DishID %>/editDish" method="POST"> 
<!-- //"=" means Run JavaScript and output the value. -->
    <label>Dish Name</label>

    <input type="text" name="dishName" value="<%= dish.DishName %>">

    <br><br>

    <label>Recipe Link</label>

    <input type="text" name="recipe" value="<%= dish.recipe %>">
    <br><br>
    <input type="submit" value="Save Changes">

</form>

<%- include("partials/footer") %>