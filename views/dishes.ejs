
<%- include("partials/header",{title:"Dishes"}) %>

<div class="container mt-4 col-md-8">

    <!-- Add Dish -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">🍽 Add New Dish</h5>
        </div>

        <div class="card-body">

            <form method="POST" action="/dishes">

                <div class="row g-3 align-items-end">

                    <div class="col-md-5">

                        <label class="form-label">
                            Dish Name
                        </label>

                        <input
                            type="text"
                            name="dishName"
                            class="form-control form-control-sm"
                            placeholder="e.g. Chicken Biryani"
                            required>

                    </div>

                    <div class="col-md-5">

                        <label class="form-label">
                            Recipe Link
                        </label>

                        <input
                            type="text"
                            name="recipe"
                            class="form-control form-control-sm"
                            placeholder="Paste recipe URL (optional)">

                    </div>

                    <div class="col-md-2">

                        <button
                            type="submit"
                            class="btn btn-success btn-sm w-100">

                            Save

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Existing Dishes -->

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <div>

                <h5 class="mb-0">

                    🍽 Existing Dishes

                    <span class="badge bg-secondary ms-2">

                        <%= dishes.length %>

                    </span>

                </h5>

            </div>

            <form action="/dishes" method="GET" class="d-flex">

                <input
                    type="text"
                    name="search"
                    class="form-control form-control-sm me-2"
                    placeholder="Search dishes..."
                    value="<%= search || '' %>"
                    style="width:220px;">

                <button
                    class="btn btn-primary btn-sm me-2">

                    Search

                </button>

                <% if(search){ %>

                    <a
                        href="/dishes"
                        class="btn btn-outline-secondary btn-sm">

                        Clear

                    </a>

                <% } %>

            </form>

        </div>

        <div class="card-body p-0">

            <% if(dishes.length === 0){ %>

                <div class="text-center py-5">

                    <h5 class="text-muted">

                        🍽 No dishes found

                    </h5>

                    <p class="text-muted mb-0">

                        Try a different search or add a new dish.

                    </p>

                </div>

            <% } else { %>

                <table class="table table-hover table-sm align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-3">
                                Dish
                            </th>

                            <th width="80" class="text-center">
                                ❤️
                            </th>

                            <th width="180" class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        <% dishes.forEach(dish => { %>

                            <tr>

                                <td class="ps-3">

                                    <a
                                        href="/dishes/<%= dish.DishID %>"
                                        class="text-decoration-none">

                                        🍽 <%= dish.DishName %>

                                    </a>

                                </td>

                                <td class="text-center">

                                    <a
                                        href="#"
                                        class="favorite-toggle text-decoration-none fs-5"
                                        data-id="<%= dish.DishID %>">

                                        <span class="heart">

                                            <%= dish.IsFavorite ? "❤️" : "🤍" %>

                                        </span>

                                    </a>

                                </td>

                                <td class="text-center">

                                    <a
                                        href="/dishes/<%= dish.DishID %>/editDish"
                                        class="btn btn-outline-primary btn-sm">

                                        Edit

                                    </a>

                                    <a
                                        href="/dishes/<%= dish.DishID %>/deleteDish"
                                        class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Delete this dish?')">

                                        Delete

                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            <% } %>

        </div>

    </div>

    <% if(totalPages > 1){ %>

        <nav class="mt-3">

            <ul class="pagination justify-content-center">

                <% for(let i=1;i<=totalPages;i++){ %>

                    <li class="page-item <%= currentPage===i ? 'active' : '' %>">

                        <a
                            class="page-link"
                            href="/dishes?page=<%= i %>&search=<%= search %>">

                            <%= i %>

                        </a>

                    </li>

                <% } %>

            </ul>

        </nav>

    <% } %>

</div>

<script>

document.querySelectorAll(".favorite-toggle").forEach(link => {

    link.addEventListener("click", async function(e){

        e.preventDefault();

        const id = this.dataset.id;

        try{

            const response = await fetch(`/dishes/${id}/favorite`);

            if(!response.ok){

                throw new Error();

            }

            const heart = this.querySelector(".heart");

            heart.textContent =
                heart.textContent.trim() === "❤️"
                ? "🤍"
                : "❤️";

        }

        catch(err){

            alert("Something went wrong.");

        }

    });

});

</script>

<%- include("partials/footer") %>

