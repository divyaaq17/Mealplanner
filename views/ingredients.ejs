
<%- include("partials/header",{title:"Ingredients"}) %>

<div class="container mt-4 col-md-8">

    <!-- Add Ingredient -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">🥕 Add New Ingredient</h5>
        </div>

        <div class="card-body">

            <form method="POST" action="/ingredients">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">

                        <label class="form-label">
                            Ingredient Name
                        </label>

                        <input
                            type="text"
                            name="ingredientName"
                            class="form-control form-control-sm"
                            placeholder="e.g. Onion"
                            required>

                    </div>

                    <div class="col-md-2">

                        <button
                            type="submit"
                            class="btn btn-success btn-sm w-100">

                            Save

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Existing Ingredients -->

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <div>

                <h5 class="mb-0">

                    🥕 Existing Ingredients

                    <span class="badge bg-secondary ms-2">

                        <%= ingredients.length %>

                    </span>

                </h5>

            </div>

            <form action="/ingredients" method="GET" class="d-flex">

                <input
                    type="text"
                    name="search"
                    class="form-control form-control-sm me-2"
                    placeholder="Search ingredients..."
                    value="<%= search || '' %>"
                    style="width:220px;">

                <button
                    class="btn btn-primary btn-sm me-2">

                    Search

                </button>

                <% if(search){ %>

                    <a
                        href="/ingredients"
                        class="btn btn-outline-secondary btn-sm">

                        Clear

                    </a>

                <% } %>

            </form>

        </div>

        <div class="card-body p-0">

            <% if(ingredients.length === 0){ %>

                <div class="text-center py-5">

                    <h5 class="text-muted">

                        🥕 No ingredients found

                    </h5>

                    <p class="text-muted mb-0">

                        Try a different search or add a new ingredient.

                    </p>

                </div>

            <% } else { %>

                <table class="table table-hover table-sm align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-3">

                                Ingredient

                            </th>

                            <th width="140" class="text-center">

                                Action

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        <% ingredients.forEach(ingredient => { %>

                            <tr>

                                <td class="ps-3">

                                    <%= ingredient.IngredientName %>

                                </td>

                                <td class="text-center">

                                    <a
                                        href="/ingredients/<%= ingredient.IngredientID %>/delete"
                                        class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Delete this ingredient?')">

                                        Delete

                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>
<% if(totalPages > 1){ %>

<nav class="mt-3">

<ul class="pagination justify-content-center">

<% for(let i=1;i<=totalPages;i++){ %>

<li class="page-item <%= currentPage===i ? 'active' : '' %>">

<a
class="page-link"
href="/ingredients?page=<%= i %>&search=<%= search %>">

<%= i %>

</a>

</li>

<% } %>

</ul>

</nav>

<% } %>
            <% } %>

        </div>

    </div>

</div>

<%- include("partials/footer") %>
```
